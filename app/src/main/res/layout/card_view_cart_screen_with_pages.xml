<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="6dp"
    android:padding="8dp"
    app:cardCornerRadius="35dp"
    app:cardElevation="0dp"
    app:cardBackgroundColor="#242425">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp"
        android:layout_marginBottom="8dp"

        >
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"

        >

        <ImageView
            android:id="@+id/image"
            android:layout_width="60dp"
            android:layout_height="77dp" />
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="2"
            android:orientation="vertical"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="10dp">
            <!-- Название товара -->
            <TextView
                android:id="@+id/basketProductName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"

                android:layout_gravity="center_vertical"
                android:fontFamily="@font/firasans"

                android:text="Название товара"
                android:textColor="@color/white"
                android:textSize="20sp" />

            <TextView
                android:id="@+id/categoryName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:fontFamily="@font/firasans"
                android:maxLines="2"
                android:background="@drawable/rounded_button"
                android:text="Название товара"
                android:textColor="@color/white"
                android:padding="3dp"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/priceForItem"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/firasans"
                android:text="100 руб."
                android:textColor="#E8221D"
                android:textSize="16sp"

                android:textStyle="bold" />

        </LinearLayout>
        <ImageView
            android:id="@+id/exploreButton"
            android:layout_width="20dp"
            android:layout_height="20dp"
          android:layout_marginEnd="10dp"
            android:background="@drawable/explore"
            android:layout_gravity="end"/>
    </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_gravity="center_vertical">
            <LinearLayout
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_gravity="center_vertical">
            <ImageView
                android:id="@+id/cartDecreaseButton"
                android:layout_width="0dp"
                android:layout_height="25dp"
                android:layout_weight="1"
                android:clickable="true"
                android:gravity="center"
                android:src="@drawable/drag_handle"
                android:textColor="@color/white" />

            <TextView
                android:id="@+id/cartQuantityTextView"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="@font/firasans"
                android:gravity="center"
                android:text="1"
                android:textColor="#FFFFFF"
                android:textSize="20sp" />

            <ImageView
                android:id="@+id/cartIncreaseButton"
                android:layout_width="0dp"
                android:layout_height="25dp"
                android:layout_weight="1"
                android:clickable="true"
                android:gravity="center"
                android:src="@drawable/plus" />
            </LinearLayout>
            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="2"


                app:helperText="Например: 1-15, 21-34"
                app:helperTextTextColor="#80FFFFFF">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/pagesRange"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Укажите диапазон страниц"
                    android:textSize="14sp"
                    android:textColor="#FFFFFF"
                    android:textColorHint="@color/text_hint"
                    android:fontFamily="@font/firasans"

                    android:paddingTop="8dp"
                    android:paddingBottom="8dp"
                    android:paddingStart="4dp"
                    android:paddingEnd="4dp"
                    />

            </com.google.android.material.textfield.TextInputLayout>

        </LinearLayout>
    </LinearLayout>
</androidx.cardview.widget.CardView>