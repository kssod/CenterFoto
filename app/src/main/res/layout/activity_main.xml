<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"

    tools:context=".activities.MainActivity"
    >
<LinearLayout
    android:id="@+id/logoBrunchesButtonContainer"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    app:layout_constraintTop_toTopOf="parent"
    app:layout_constraintStart_toStartOf="parent"
    app:layout_constraintBottom_toTopOf="@+id/editTextSearching"
    app:layout_constraintEnd_toEndOf="parent"
    android:layout_marginStart="10dp"
    android:layout_marginTop="6dp"
    android:layout_marginEnd="10dp"
    android:layout_marginBottom="6dp"
    android:gravity="center_vertical"
    android:layout_gravity="center_vertical">
    <ImageView
         android:id="@+id/logoImageView"
         android:layout_width="120dp"
         android:layout_height="40dp"
         android:src="@drawable/logo3"
         android:contentDescription="@string/logo_description"
         android:clickable="true"
        android:layout_gravity="center_vertical"
        />
    <View
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:layout_weight="1" />

    <LinearLayout
        android:id="@+id/branchSelectorButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"

        android:clickable="true"
        android:focusable="true"
       >

        <TextView
            android:id="@+id/textViewAddress"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Выберите филиал"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:fontFamily="@font/firasans"
         />

        <ImageView
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:layout_marginStart="8dp"
            android:src="@drawable/ic_arrow_down"
            android:layout_gravity="center_vertical" />

    </LinearLayout>


</LinearLayout>
    <EditText
        android:id="@+id/editTextSearching"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:fontFamily="@font/firasans"
        android:hint="Что желаете реализовать?"
        android:textColorHint="#A9FFFFFF"
        android:cursorVisible="true"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingBottom="12dp"
        android:paddingTop="12dp"
        android:drawableStart="@drawable/search_icon"
        android:drawablePadding="12dp"
        android:textColor="@color/white"
        android:textSize="17sp"
        android:background="@drawable/search_edittext_background"
        android:layout_marginStart="10dp"
        android:layout_marginTop="6dp"
        android:layout_marginEnd="10dp"
        android:layout_marginBottom="6dp"
        app:layout_constraintBottom_toTopOf="@id/recyclerServices"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/logoBrunchesButtonContainer" />

    <androidx.recyclerview.widget.RecyclerView
       android:id="@+id/recyclerServices"
       android:layout_width="0dp"
       android:layout_height="0dp"
       app:layout_constraintTop_toBottomOf="@id/editTextSearching"
       app:layout_constraintBottom_toBottomOf="parent"
       app:layout_constraintStart_toStartOf="parent"
       app:layout_constraintEnd_toEndOf="parent"



       android:paddingStart="5dp"
       android:paddingEnd="5dp"
       android:paddingTop="5dp"
       android:paddingBottom="0dp"

    android:clipToPadding="true"
    android:scrollbars="none"
       />

    <ImageButton
        android:id="@+id/basketButton"
        android:layout_width="65dp"
        android:layout_height="65dp"
        android:layout_marginEnd="16dp"
     

        android:padding="8dp"
        android:layout_marginBottom="16dp"
        android:background="@drawable/circular_button_background"
        app:layout_constraintBottom_toBottomOf="parent"
        android:src="@drawable/cart"
        app:layout_constraintEnd_toEndOf="parent"
        android:scaleType="centerInside"/>


</androidx.constraintlayout.widget.ConstraintLayout>