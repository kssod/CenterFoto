<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="8dp"
    android:layout_marginBottom="6dp"
    app:cardCornerRadius="35dp"
    app:cardElevation="0dp"
    app:cardBackgroundColor="#242425"
  >

<LinearLayout

    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:padding="12dp"
    android:layout_marginBottom="8dp"

  >

    <ImageView
    android:id="@+id/image"
    android:layout_width="60dp"
    android:layout_height="100dp"
        android:padding="6dp"
        />
<LinearLayout
    android:layout_width="0dp"
    android:layout_height="wrap_content"
    android:layout_weight="1"
    android:orientation="vertical"
    android:layout_marginStart="16dp">

    <TextView
        android:id="@+id/basketProductName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"

        android:layout_gravity="center_vertical"
        android:fontFamily="@font/firasans"

        android:text="Имя файла"
        android:textColor="@color/white"
        android:textSize="20sp" />

    <TextView
        android:id="@+id/categoryName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_vertical"
        android:fontFamily="@font/firasans"
        android:maxLines="2"
        android:background="@drawable/rounded_button"
        android:text="Название товара"
        android:textColor="@color/white"
        android:padding="3dp"
        android:textSize="16sp" />

    <TextView
        android:id="@+id/priceForItem"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/firasans"
        android:text="100 руб."
        android:textColor="#E8221D"
        android:textSize="16sp"

        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_gravity="center_vertical">

        <ImageView
            android:id="@+id/cartDecreaseButton"
            android:layout_width="25dp"
            android:layout_height="25dp"
            android:clickable="true"
            android:gravity="center"
            android:src="@drawable/drag_handle"
            android:textColor="@color/white" />


        <TextView
            android:id="@+id/cartQuantityTextView"
            android:layout_width="40dp"
            android:layout_height="wrap_content"
            android:fontFamily="@font/firasans"
            android:gravity="center"
            android:text="1"
            android:textColor="#FFFFFF"
            android:textSize="20sp" />

        <ImageView

            android:id="@+id/cartIncreaseButton"
            android:layout_width="25dp"
            android:layout_height="25dp"
            android:clickable="true"
            android:gravity="center"
            android:src="@drawable/plus" />

    </LinearLayout>

</LinearLayout>
    <ImageView
        android:id="@+id/exploreButton"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:layout_marginEnd="10dp"
        android:background="@drawable/explore"
        android:layout_gravity="end"/>
</LinearLayout>
</androidx.cardview.widget.CardView>
