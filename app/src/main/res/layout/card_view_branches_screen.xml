<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    app:cardCornerRadius="35dp"
    android:layout_marginBottom="6dp"
    >
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="8dp"
        android:background="#242425"
       >
    <LinearLayout
        android:id="@+id/nameAddressPointContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"

        android:layout_marginBottom="6dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:background="@null"
        android:gravity="center_vertical" >

        <LinearLayout
            android:layout_width="0dp"
            android:layout_weight="3"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="6dp"
            android:layout_gravity="center">
            <TextView
                android:id="@+id/branchName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/firasans"
                android:text="Филиал"
                android:textSize="15sp"
                android:textColor="@color/white"
                />
            <TextView
                android:padding="3dp"
                android:id="@+id/branchAddress"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/firasans"
                android:text="Адрес филиала"
                android:textSize="18sp"
                android:textColor="@color/white"
                android:background="@drawable/rounded_button"
                />
            <TextView
                android:id="@+id/branchEmail"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/firasans"
                android:text="Почтовый адрес"
                android:textSize="15sp"
                android:textColor="@color/white"
                />
        </LinearLayout>

        <ImageButton
            android:id="@+id/whatsappButton"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:scaleType="centerInside"
            android:text="WhatsApp"
            android:layout_weight="1"
            android:src="@drawable/waicon"
            android:background="?attr/selectableItemBackgroundBorderless"
          ></ImageButton>
        <ImageButton
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:scaleType="centerInside"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/locicon">
        </ImageButton>

    </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.cardview.widget.CardView>