<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.CenterFoto" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/md_theme_light_primary</item>
        <item name="colorPrimaryVariant">@color/md_theme_light_primaryContainer</item>
        <item name="colorOnPrimary">@color/white</item>
        <!-- Очень важно для статус-бара и навигации -->
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>          <!-- тёмные иконки → меньше scrim -->
        <item name="android:windowLightNavigationBar">true</item>

        <!-- Отключаем enforced contrast / scrim на Android 14+ -->
        <item name="android:enforceStatusBarContrast">false</item>
        <item name="android:enforceNavigationBarContrast">false</item>

    </style>

    <style name="Theme.CenterFoto" parent="Base.Theme.CenterFoto" />
</resources>