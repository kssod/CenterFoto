<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.CenterFoto" parent="Theme.Material3.Dark.NoActionBar">
        <item name="colorPrimary">#E51A2D</item>
        <item name="colorPrimaryVariant">#F44336</item>
        <item name="colorOnPrimary">#0036FA</item>
        <!-- Очень важно для статус-бара и навигации -->
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>

        <item name="android:windowLightNavigationBar">true</item>

        <!-- Отключаем enforced contrast / scrim на Android 14+ -->
        <item name="android:enforceStatusBarContrast">false</item>
        <item name="android:enforceNavigationBarContrast">false</item>

    </style>

    <style name="Theme.CenterFoto" parent="Base.Theme.CenterFoto" />
</resources>